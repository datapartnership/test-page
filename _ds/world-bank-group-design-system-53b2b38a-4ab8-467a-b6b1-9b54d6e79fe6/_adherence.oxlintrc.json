{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/banners/**",
              "components/cards/**",
              "components/content/**",
              "components/core/**",
              "components/data/**",
              "components/forms/**",
              "components/navigation/**",
              "ui_kits/worldbank-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Andes|AndesBold|loop_icon|Open Sans))/i]",
        "message": "Font not provided by the design system. Available: Andes, AndesBold, loop_icon, Open Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|image|title|description|ctas|circleImage|height|style|key|ref|className|style|children)$/]",
        "message": "<Banner> doesn't accept that prop. Declared props: variant, image, title, description, ctas, circleImage, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Banner'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:landing|landingRight|homepage|topic|campaign)$/]",
        "message": "<Banner> variant must be one of 'landing' | 'landingRight' | 'homepage' | 'topic' | 'campaign'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Breadcrumb'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|style|key|ref|className|style|children)$/]",
        "message": "<Breadcrumb> doesn't accept that prop. Declared props: items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|block|icon|href|type|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, block, icon, href, type, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|orange|navy|inverse|ghost|ghostInverse)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'orange' | 'navy' | 'inverse' | 'ghost' | 'ghostInverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm|xs)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|defaultChecked|onChange|disabled|inverse|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, defaultChecked, onChange, disabled, inverse, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|imageHeight|hammer|title|description|links|horizontalLinks|inverse|background|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ContentCard> doesn't accept that prop. Declared props: image, imageHeight, hammer, title, description, links, horizontalLinks, inverse, background, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|onClick|style|children|key|ref|className|style|children)$/]",
        "message": "<CtaButton> doesn't accept that prop. Declared props: variant, href, onClick, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:white|blue|gray|gradient|link)$/]",
        "message": "<CtaButton> variant must be one of 'white' | 'blue' | 'gray' | 'gradient' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|inverse|sortable|title|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: columns, rows, inverse, sortable, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropdown'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|options|value|onChange|placeholder|label|style|key|ref|className|style|children)$/]",
        "message": "<Dropdown> doesn't accept that prop. Declared props: variant, options, value, onChange, placeholder, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dropdown'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|primaryInverse|secondary|secondaryInverse)$/]",
        "message": "<Dropdown> variant must be one of 'primary' | 'primaryInverse' | 'secondary' | 'secondaryInverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Expert'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|role|description|image|variant|href|style|key|ref|className|style|children)$/]",
        "message": "<Expert> doesn't accept that prop. Declared props: name, role, description, image, variant, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Expert'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|stack|inline)$/]",
        "message": "<Expert> variant must be one of 'default' | 'stack' | 'inline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FocusCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|description|height|style|key|ref|className|style|children)$/]",
        "message": "<FocusCard> doesn't accept that prop. Declared props: image, title, description, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GlobalNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|active|megamenu|key|ref|className|style|children)$/]",
        "message": "<GlobalNavItem> doesn't accept that prop. Declared props: label, href, active, megamenu."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hammer'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|color|style|key|ref|className|style|children)$/]",
        "message": "<Hammer> doesn't accept that prop. Declared props: items, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageOverlayCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|title|description|hammer|height|style|key|ref|className|style|children)$/]",
        "message": "<ImageOverlayCard> doesn't accept that prop. Declared props: image, title, description, hammer, height, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineApiItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:meta|title|description|primary|href|style|key|ref|className|style|children)$/]",
        "message": "<InlineApiItem> doesn't accept that prop. Declared props: meta, title, description, primary, href, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LeftNavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|children|key|ref|className|style|children)$/]",
        "message": "<LeftNavItem> doesn't accept that prop. Declared props: id, label, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='LinkList'] > JSXAttribute > JSXIdentifier[name!=/^(?:heading|items|style|key|ref|className|style|children)$/]",
        "message": "<LinkList> doesn't accept that prop. Declared props: heading, items, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pagination'] > JSXAttribute > JSXIdentifier[name!=/^(?:page|total|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Pagination> doesn't accept that prop. Declared props: page, total, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pullquote'] > JSXAttribute > JSXIdentifier[name!=/^(?:quote|author|role|image|style|key|ref|className|style|children)$/]",
        "message": "<Pullquote> doesn't accept that prop. Declared props: quote, author, role, image, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Radio'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|inverse|name|style|key|ref|className|style|children)$/]",
        "message": "<Radio> doesn't accept that prop. Declared props: label, checked, onChange, disabled, inverse, name, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|description|icon|links|background|layout|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: value, label, description, icon, links, background, layout, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='layout'] > Literal[value!=/^(?:stacked|horizontal)$/]",
        "message": "<StatCard> layout must be one of 'stacked' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Synopsis'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|style|key|ref|className|style|children)$/]",
        "message": "<Synopsis> doesn't accept that prop. Declared props: title, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|active|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, active, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|labelInverse|placeholder|value|onChange|search|onSubmit|disabled|type|style|key|ref|className|style|children)$/]",
        "message": "<TextInput> doesn't accept that prop. Declared props: variant, label, labelInverse, placeholder, value, onChange, search, onSubmit, disabled, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextInput'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|inverse)$/]",
        "message": "<TextInput> variant must be one of 'primary' | 'secondary' | 'inverse'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tweetable'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|style|key|ref|className|style|children)$/]",
        "message": "<Tweetable> doesn't accept that prop. Declared props: children, href, style."
      }
    ]
  },
